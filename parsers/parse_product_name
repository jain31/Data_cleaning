import pandas as pd
def parse_product_name(val):   
    if (
        pd.isnull(val)
        or str(val).strip() == ""
        or str(val).lower() in ["nan", "null", "n/a", "<na>"]
        ):
        return pd.NA

    val = str(val).strip()

    val = re.sub(r"\s*([-(,].*)$", "", val)
    val = re.sub(r"\s+", " ", val)

    return val.strip()

